# Copia este archivo como .env y llena tus datos reales
# NUNCA subas el archivo .env a GitHub

PORT=3000

# Cadena de conexion de MongoDB Atlas (la misma que usas en Compass)
# Reemplaza USUARIO y PASSWORD por los de tu usuario de base de datos
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.svvyti0.mongodb.net/televerde

# Palabra secreta para firmar los tokens (inventa una larga)
JWT_SECRET=cambia_esta_palabra_por_una_muy_larga_y_secreta

# Datos del administrador que crea el script "npm run seed"
ADMIN_EMAIL=admin@televerde.com
ADMIN_PASSWORD=Admin123
